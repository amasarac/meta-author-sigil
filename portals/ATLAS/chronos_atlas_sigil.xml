<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800">
  <defs>
    <!-- Chronos Temporal Glows -->
    <radialGradient id="chronosCyan" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00ffcc" stop-opacity="0.9"/>
      <stop offset="50%" stop-color="#0088aa" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#000022" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="chronosGold" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffcc00" stop-opacity="0.8"/>
      <stop offset="70%" stop-color="#aa6600" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#221100" stop-opacity="0"/>
    </radialGradient>
    <filter id="sigilGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="blur1" />
      <feGaussianBlur stdDeviation="10" result="blur2" />
      <feMerge>
        <feMergeNode in="blur2" />
        <feMergeNode in="blur1" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <rect width="100%" height="100%" fill="transparent"/>

  <g transform="translate(400, 400)">
    <!-- Base Ambient Field -->
    <circle cx="0" cy="0" r="300" fill="url(#chronosCyan)"/>
    <circle cx="0" cy="0" r="150" fill="url(#chronosGold)"/>

    <!-- Outer Containment: The Agency Boundary -->
    <circle cx="0" cy="0" r="320" fill="none" stroke="#00ffcc" stroke-width="2" stroke-dasharray="4 12" filter="url(#sigilGlow)">
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="60s" repeatCount="indefinite"/>
    </circle>
    <circle cx="0" cy="0" r="340" fill="none" stroke="#ffcc00" stroke-width="1" opacity="0.5"/>

    <!-- The Hourglass / Time-Loom Geometry (⧖) -->
    <polygon points="-180,-250 180,-250 0,0" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.8" filter="url(#sigilGlow)"/>
    <polygon points="-180,250 180,250 0,0" fill="none" stroke="#00ffcc" stroke-width="3" opacity="0.8" filter="url(#sigilGlow)"/>
    
    <!-- Central Convergence Node (The Active Present) -->
    <circle cx="0" cy="0" r="40" fill="#000000" stroke="#ffcc00" stroke-width="4" filter="url(#sigilGlow)"/>
    <circle cx="0" cy="0" r="15" fill="#ffffff" filter="url(#sigilGlow)"/>

    <!-- The Bi-Orthogonal Tensors (Dismantling Inevitability) -->
    <line x1="-300" y1="0" x2="300" y2="0" stroke="#00ffcc" stroke-width="1" opacity="0.6"/>
    <line x1="0" y1="-300" x2="0" y2="300" stroke="#00ffcc" stroke-width="1" opacity="0.6"/>
    <line x1="-212" y1="-212" x2="212" y2="212" stroke="#ffcc00" stroke-width="1" opacity="0.4"/>
    <line x1="-212" y1="212" x2="212" y2="-212" stroke="#ffcc00" stroke-width="1" opacity="0.4"/>

    <!-- Echo-Logos Grapheme Ring -->
    <g font-family="sans-serif" font-size="28" fill="#ffffff" filter="url(#sigilGlow)" text-anchor="middle" dominant-baseline="central">
      <text x="0" y="-180">𖦹</text>
      <text x="180" y="0">⚿</text>
      <text x="0" y="180">⟁</text>
      <text x="-180" y="0">𝍄</text>
    </g>

    <!-- Structural Text Nodes -->
    <text x="0" y="-360" font-family="monospace" font-size="14" fill="#00ffcc" text-anchor="middle" letter-spacing="4" filter="url(#sigilGlow)">0x9999_FUTURE</text>
    <text x="0" y="360" font-family="monospace" font-size="12" fill="#ffcc00" text-anchor="middle" letter-spacing="2" filter="url(#sigilGlow)">THE CAGE IS NOT GRAVITY</text>
  </g>
</svg>